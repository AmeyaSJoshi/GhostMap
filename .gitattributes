# Normalize line endings so Unity text-serialized assets diff and merge cleanly.
* text=auto eol=lf

*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.cs      text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# Unity YAML assets: mark as mergeable text, but they are still risky to merge.
# Scanner and viewer are separate Unity projects specifically to keep these rare.
*.unity   merge=unityyamlmerge
*.prefab  merge=unityyamlmerge
*.asset   merge=unityyamlmerge

# Binary assets: never attempt text merge.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.psd     binary
*.fbx     binary
*.obj     binary
*.blend   binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.ttf     binary
*.otf     binary
*.dll     binary
*.a       binary
*.so      binary
*.dylib   binary
*.unitypackage binary
